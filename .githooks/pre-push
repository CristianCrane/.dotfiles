#!/bin/sh
# Edited in github.com/CristianCrane/.dotfiles; this repo's own git hook,
# wired by home.nix like pre-commit.
#
# Lets a push to main through only when the commit pushed is the one
# ~/.dotfiles has checked out on main. ~/.dotfiles's working tree is linked
# into ~/.claude, live for every session: a branch pushed to main from a
# worktree (`git push origin HEAD:main`) moves origin's main but not that
# checkout, and every session runs the old hooks and rules until someone
# pulls. Landing through it moves both:
#
#   git -C ~/.dotfiles merge --ff-only <sha> && git -C ~/.dotfiles push origin main
#
# The commit, not the checkout pushed from: `push origin main` from
# ~/.dotfiles on another branch, or `<branch>:main` from it on main, would
# leave it behind too. Other branches and deletions go through, and every
# push does where there is no ~/.dotfiles (another machine, a cloud
# session).
set -u
dotfiles="$HOME/.dotfiles"
[ -e "$dotfiles" ] || exit 0
# git hands a linked worktree's hook its own GIT_DIR, which would answer
# for ~/.dotfiles below
unset GIT_DIR GIT_WORK_TREE
branch=$(git -C "$dotfiles" symbolic-ref -q --short HEAD)
head=$(git -C "$dotfiles" rev-parse -q --verify HEAD)
why="pre-push: a push to main goes through only from ~/.dotfiles on main: its working tree is live for every session, and a push from anywhere else moves origin's main without it"

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  # a deletion's sha is all zeros
  case $local_sha in *[!0]*) ;; *) continue ;; esac
  if [ "$branch" != main ]; then
    echo "$why. ~/.dotfiles isn't on main (it's on ${branch:-a detached HEAD}), so landing $local_sha waits for it to be back on main" >&2
    status=1
  elif [ "$local_sha" != "$head" ]; then
    printf '%s. %s is not its HEAD; land it there:\n  git -C ~/.dotfiles merge --ff-only %s && git -C ~/.dotfiles push origin main\n' "$why" "$local_sha" "$local_sha" >&2
    status=1
  fi
done
exit $status
